# HB Briefing v1.0.0 Configuration
# Copy to .env and fill in what you need. Everything here is optional -
# with no key at all the monitor still runs on the offline heuristic.

# --- LLM / AI provider ------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint works.
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions

# Legacy names still honoured when the LLM_* values above are absent.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# DEEPSEEK_BASE_URL=

# Examples:
#   OpenAI   LLM_BASE_URL=https://api.openai.com/v1/chat/completions  LLM_MODEL=gpt-4o-mini
#   Ollama   LLM_BASE_URL=http://localhost:11434/v1/chat/completions  LLM_MODEL=llama3.1
#   Custom   any OpenAI-compatible gateway

# --- Domain profile --------------------------------------------------------
# Optional: point the engine at a different industry (see profiles/).
# WATCHDOG_PROFILE=profiles/cybersecurity.json

# --- AI pipeline tuning ----------------------------------------------------
WATCHDOG_DEEP_READ=1          # 0 disables article fetching (stage 2)
WATCHDOG_MAX_DEEP_READS=8     # article fetches per scan
WATCHDOG_MAX_TRIAGE=40        # model screening calls per scan; rest score offline
WATCHDOG_BRIEFING=1           # 0 disables the executive briefing (stage 3)
WATCHDOG_BRIEF_HOURS=24       # how far back the briefing looks for signals

# --- Notifications (email and free carrier email-to-SMS gateway) -----------
# Leave SMTP_HOST blank to keep notifications off.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls        # starttls | ssl | none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=              # comma separated
NOTIFY_SMS_TO=                # bare numbers or full gateway addresses
SMS_GATEWAY_DOMAIN=vtext.com  # or att / tmobile / sprint / uscellular / googlefi / cricket / metro
